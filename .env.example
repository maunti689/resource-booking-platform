DJANGO_SECRET_KEY=replace-with-at-least-32-random-characters
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://booking:local-only-booking@postgres:5432/booking
CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
LOG_LEVEL=INFO
BOOKING_DEFAULT_MAX_DURATION_MINUTES=480
BOOKING_REMINDER_LEAD_MINUTES=30
AVAILABILITY_SLOT_STEP_MINUTES=30
AVAILABILITY_CACHE_TTL_SECONDS=60
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
